<?xml version="1.0"?>
<ruleset name="Hipcall WordPress Plugin">
	<description>WordPress Coding Standards for Hipcall Plugin</description>

	<file>./hipcall.php</file>
	<file>./uninstall.php</file>
	<file>./includes</file>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Extra"/>

	<config name="minimum_supported_wp_version" value="6.3"/>
</ruleset>
